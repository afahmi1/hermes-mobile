// Shared build settings for Hermes Mobile.
//
// Your Apple team and bundle ID do NOT go here. Copy Signing.xcconfig.example to
// Signing.xcconfig (git-ignored) and set them there; it overrides the defaults below.

MARKETING_VERSION = 1.0
// Bump for every upload to App Store Connect (or pass CURRENT_PROJECT_VERSION=N to xcodebuild).
CURRENT_PROJECT_VERSION = 19

// Defaults, overridden by Signing.xcconfig.
DEVELOPMENT_TEAM =
HERMES_BUNDLE_ID = com.example.hermesmobile

#include? "Signing.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(HERMES_BUNDLE_ID)
